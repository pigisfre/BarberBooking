# Variabili facoltative: di default le app leggono URL e chiave pubblica da brands/<id>/brand.json.
# Copia in apps/<app>/.env.local se vuoi cambiarle senza toccare il brand. Mai chiavi segrete qui:
# le app sono pubbliche, tutto cio che inizia con EXPO_PUBLIC_ finisce nel bundle.

# BRAND=demo                         # quale cartella di brands/ usare (lo legge app.config.ts)
# EXPO_PUBLIC_BACKEND=fake           # usa il backend finto locale (pnpm dev:server) invece di Supabase
# EXPO_PUBLIC_FAKE_URL=http://localhost:8787
# EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_...   # chiave PUBBLICA (publishable / anon), mai la secret / service_role
