  "shadow": {
    "_about": "RN 0.76+ supporta boxShadow su iOS, Android e web. Superfici piu grandi = ombra piu profonda.",
    "card": "0 1px 2px rgba(0,0,0,0.04), 0 2px 8px rgba(0,0,0,0.06)",
    "pop": "0 8px 24px rgba(0,0,0,0.12), 0 2px 6px rgba(0,0,0,0.06)",
    "sheet": "0 -4px 32px rgba(0,0,0,0.16)",
    "lift": "0 12px 32px rgba(0,0,0,0.20)"
  },
  "motion": {
    "_about": "Molle (apple-design §4). Reanimated withSpring({dampingRatio, duration}). 'duration' di Reanimated e un tempo percettivo, non la 'response' di Apple: i valori sono un punto di partenza da tarare sul dispositivo. Rimbalzo SOLO dopo un gesto con slancio.",
    "spring": {
      "default": {
        "dampingRatio": 1.0,
        "duration": 400,
        "use": "spostamenti, cambi di layout, comparse"
      },
      "snappy": {
        "dampingRatio": 1.0,
        "duration": 300,
        "use": "selezioni, toggle, chip"
      },
      "sheet": {
        "dampingRatio": 0.85,
        "duration": 350,
        "use": "pannelli dal basso, dopo un trascinamento"
      },
      "momentum": {
        "dampingRatio": 0.8,
        "duration": 400,
        "use": "rilascio dopo un flick o un drag (agenda)"
      }
    },
    "press": {
      "scale": 0.97,
      "inMs": 0,
      "outSpring": "snappy",
      "use": "feedback alla PRESSIONE, non al rilascio"
    },
    "reduced": {
      "crossfadeMs": 200,
      "use": "con 'riduci movimento': dissolvenza, niente scorrimenti o rimbalzi"
    },
    "projection": {
      "decelerationRate": 0.998,
      "use": "proiezione del punto di arrivo dopo un flick (apple-design §6)"
    },
    "dragThreshold": 10,
    "rubberbandConstant": 0.55
  },
  "haptics": {
    "_about": "expo-haptics, solo nei momenti che contano (apple-design §13), sullo stesso frame dell'animazione.",
    "select": "selectionAsync: scelta di slot, servizio, operatore",
    "success": "notificationAsync(Success): prenotazione confermata",
    "warning": "notificationAsync(Warning): slot appena preso da un altro",
    "pickup": "impactAsync(Light): presa di un appuntamento in agenda",
    "drop": "impactAsync(Medium): appuntamento rilasciato su un nuovo orario"
  },
