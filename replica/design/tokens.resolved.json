  "brand": {
    "_about": "Gli unici token che cambiano per cliente. brand.json da solo il colore 'accent' (e opzionalmente 'accentDark'); gli altri si derivano: on-accent = bianco o quasi-nero, quello con piu contrasto; accent-text = accent scurito (chiaro) o schiarito (scuro) finche non fa 4.5:1 su surface e bg; accent-tint = accent al 10% su surface. La build fallisce se un brand non passa contrast.py.",
    "overridable": [
      "accent",
      "on-accent",
      "accent-text",
      "accent-tint"
    ]
  },
  "material": {
    "_about": "Superfici traslucide (apple-design §12). Native: expo-blur BlurView; web: backdrop-filter. Con 'riduci trasparenza' diventano 'surface' piene.",
    "light": {
      "chrome": {
        "bg": "rgba(255,255,255,0.72)",
        "blur": 20,
        "saturate": 1.8,
        "edge": "rgba(0,0,0,0.08)"
      },
      "sheet": {
        "bg": "rgba(255,255,255,0.86)",
        "blur": 30,
        "saturate": 1.8
      },
      "scrim": "rgba(0,0,0,0.32)"
    },
    "dark": {
      "chrome": {
        "bg": "rgba(28,28,30,0.72)",
        "blur": 20,
        "saturate": 1.8,
