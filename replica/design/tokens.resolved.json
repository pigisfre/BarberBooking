      },
      "scrim": "rgba(0,0,0,0.48)"
    },
    "photoOverlay": {
      "_about": "testo sopra foto (copertina del salone): sempre #ffffff su questa sfumatura, in entrambi i temi",
      "gradient": "rgba(0,0,0,0) -> rgba(0,0,0,0.55), dal 40% dell'altezza in giu",
      "text": "#ffffff"
    }
  },
  "font": {
    "_about": "Font di sistema (apple-design §15): SF Pro su iOS e Mac, Roboto su Android, Segoe UI su Windows. Nessun font da licenziare. Numeri tabulari per orari e prezzi.",
    "sans": "system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif",
    "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace",
    "numeric": "tabular-nums"
  },
